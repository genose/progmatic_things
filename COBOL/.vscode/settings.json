{
  // ── GnuCOBOL (MacPorts) ────────────────────────────────────────────────────
  "cobolit.cobc": "/opt/local/bin/cobc",

  // ── Copybooks : GSTK + CRM + stubs locaux générés par 04_cobc_check.sh ────
  "cobolit.copybookLocalPath": [
    "${workspaceFolder}/GSTK",
    "${workspaceFolder}/CRM"
  ],
  "cobolit.copybookExtensions": [
    ".cpy", ".CPY", ".cbl", ".CBL"
  ],

  // ── Dialecte IBM pour CICS (EXEC CICS / EXEC SQL non signalés en erreur) ──
  "cobolit.dialect": "ibm",

  // ── Associations de fichiers ────────────────────────────────────────────────
  "files.associations": {
    "*.cbl": "COBOL",
    "*.CBL": "COBOL",
    "*.cpy": "COBOL",
    "*.CPY": "COBOL",
    "*.bms": "asm",
    "*.BMS": "asm",
    "*.jcl": "jcl",
    "*.JCL": "jcl"
  },

  // ── Formatage ───────────────────────────────────────────────────────────────
  "[COBOL]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [7, 11, 72, 80]  // marges COBOL : seq/ind/area-a/area-b/limit
  },
  "[asm]": {
    "editor.tabSize": 8,
    "editor.rulers": [72, 80]
  },

  // ── Terminal intégré ────────────────────────────────────────────────────────
  "terminal.integrated.env.osx": {
    "WORKSPACE_FOLDER": "${workspaceFolder}",
    "COBC": "/opt/local/bin/cobc",
    "COB_CC": "/usr/bin/clang"
  }
}
