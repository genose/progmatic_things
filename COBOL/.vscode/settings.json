{
  // ── GnuCOBOL — résolu via PATH (override local possible dans settings locaux)
  // macOS MacPorts : /opt/local/bin/cobc
  // macOS Homebrew : /usr/local/bin/cobc  ou  /opt/homebrew/bin/cobc
  // Linux          : /usr/bin/cobc
  // Windows (WSL)  : cobc (dans PATH WSL)
  "cobolit.cobc": "cobc",

  // ── Copybooks projet ────────────────────────────────────────────────────────
  "cobolit.copybookLocalPath": [
    "${workspaceFolder}/GSTK",
    "${workspaceFolder}/CRM"
  ],
  "cobolit.copybookExtensions": [
    ".cpy", ".CPY", ".cbl", ".CBL"
  ],

  // ── Dialecte IBM — supprime faux positifs sur EXEC CICS / EXEC SQL ─────────
  "cobolit.dialect": "ibm",

  // ── Associations de fichiers ────────────────────────────────────────────────
  "files.associations": {
    "*.cbl": "COBOL",
    "*.CBL": "COBOL",
    "*.cpy": "COBOL",
    "*.CPY": "COBOL",
    "*.bms": "asm",
    "*.BMS": "asm",
    "*.jcl": "jcl",
    "*.JCL": "jcl"
  },

  // ── Formatage ───────────────────────────────────────────────────────────────
  "[COBOL]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [7, 11, 72, 80]
  },
  "[asm]": {
    "editor.tabSize": 8,
    "editor.rulers": [72, 80]
  },

  // ── Variables d'environnement terminal ─────────────────────────────────────
  "terminal.integrated.env.osx": {
    "WORKSPACE_FOLDER": "${workspaceFolder}",
    "COBC": "/opt/local/bin/cobc",
    "COB_CC": "/usr/bin/clang"
  },
  "terminal.integrated.env.linux": {
    "WORKSPACE_FOLDER": "${workspaceFolder}"
  },
  "terminal.integrated.env.windows": {
    "WORKSPACE_FOLDER": "${workspaceFolder}"
  }
}
