      "options": {
        "cwd": "${workspaceFolder}/GSTK",
        "env": { "WORKSPACE_FOLDER": "${workspaceFolder}" }
      },
      "windows": {
        "command": "wsl",
        "args": [
          "bash", "-lc",
          "source '$(wslpath '${workspaceFolder}')/setup_cobol_env.sh' && bash '$(wslpath '${workspaceFolder}')/GSTK/scripts/04_cobc_check.sh'"
        ]
