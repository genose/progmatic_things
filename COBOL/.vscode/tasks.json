{
  "version": "2.0.0",
  "tasks": [

    // ──────────────────────────────────────────────────────────────────────────
    // COBOL local — GnuCOBOL (macOS / Linux / Windows)
    // ──────────────────────────────────────────────────────────────────────────
    {
      "label": "COBOL: Compile current file",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "source '${workspaceFolder}/setup_cobol_env.sh' && mkdir -p '${workspaceFolder}/bin' && \"$COBC\" -x -o '${workspaceFolder}/bin/${fileBasenameNoExtension}' '${file}'"
      ],
      "options": {
        "env": { "WORKSPACE_FOLDER": "${workspaceFolder}" }
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command",
          "$ws='${workspaceFolder}'; $bin=Join-Path $ws 'bin'; if (!(Test-Path $bin)) { New-Item -ItemType Directory -Path $bin | Out-Null }; $cobc=Get-Command cobc -ErrorAction Stop; & $cobc.Source -x -o (Join-Path $bin '${fileBasenameNoExtension}.exe') '${file}'"
        ]
      },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },

    {
      "label": "COBOL: Compile all files",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "source '${workspaceFolder}/setup_cobol_env.sh' && mkdir -p '${workspaceFolder}/bin' && shopt -s nullglob && for f in '${workspaceFolder}'/*.cbl '${workspaceFolder}'/*.CBL; do name=$(basename \"$f\"); \"$COBC\" -x -o '${workspaceFolder}/bin/'"${name%.*}"\" \"$f\"; done"
      ],
      "options": {
        "env": { "WORKSPACE_FOLDER": "${workspaceFolder}" }
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command",
          "$ws='${workspaceFolder}'; $bin=Join-Path $ws 'bin'; if (!(Test-Path $bin)) { New-Item -ItemType Directory -Path $bin | Out-Null }; $cobc=Get-Command cobc -ErrorAction Stop; Get-ChildItem $ws -Include *.cbl,*.CBL -File | ForEach-Object { & $cobc.Source -x -o (Join-Path $bin ($_.BaseName + '.exe')) $_.FullName }"
        ]
      },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },

    // ──────────────────────────────────────────────────────────────────────────
    // GSTK local — syntaxe + SQL
    // Windows : via WSL bash (scripts POSIX)
    // ──────────────────────────────────────────────────────────────────────────
    {
      "label": "GSTK: Syntax check (GnuCOBOL)",
