//GSTKCOMP JOB (ACCT),'GSTK COBOL COMPILE',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             USER=&SYSUID,PASSWORD=&TSO_PASS
//*
//*=============================================================*
//* JOB : GSTKCOMP - COMPILATION CICS/COBOL + LINK EDIT GSTK   *
//*                                                             *
//* Chaîne : SOURCE → TRANSLATOR CICS → COBOL → LINK EDIT      *
//*                                                             *
//* ADAPTER :                                                   *
//*   HLQ     = votre HLQ (ex: HERC01)                         *
//*   CICSHLQ  = HLQ bibliothèques CICS                        *
//*   DB2HLQ   = HLQ bibliothèques DB2                         *
//*   COBHLQ   = HLQ compilateur COBOL                         *
//*=============================================================*
//*
//         SET HLQ=HERC02
//         SET CICSHLQ=CICSTS
//         SET DB2HLQ=DB2
//         SET COBHLQ=IGY
//*
//* PROCLIB avec la procédure catalogue DFHEITALC (CICS+COBOL+DB2)
//* ou DFHITCL (CICS+COBOL sans DB2)
//* Sur TK5 : adapter selon les procs disponibles dans SYS1.PROCLIB
//*
//*-------------------------------------------------------------*
//* EXEMPLE : GSTK000 - MENU (pas de SQL → procédure plus simple)
//*-------------------------------------------------------------*
//G000TRAN EXEC DFHITCL,
//             PARM.TRN='',
//             PARM.COB='LIB,APOST,MAP,NODYNAM',
//             PARM.LKED='XREF,LET,LIST,AMODE=31,RMODE=ANY'
//*
//TRN.SYSIN  DD DSN=&HLQ..GSTK.SOURCE(GSTK000),DISP=SHR
//COB.SYSLIB DD DSN=&HLQ..GSTK.COPYLIB,DISP=SHR
//           DD DSN=&CICSHLQ..SDFHCOB,DISP=SHR
//LKED.SYSLMOD DD DSN=&HLQ..GSTK.LOADLIB(GSTK000),DISP=SHR
//LKED.SYSLIB  DD DSN=&CICSHLQ..SDFHLOAD,DISP=SHR
//             DD DSN=SYS1.COBLIB,DISP=SHR
//*
//*-------------------------------------------------------------*
//* GSTK001 à GSTK007 : avec DB2 → procédure DFHEITALC
//* (CICS Translator + COBOL + DB2 Precompiler + Link Edit)
//*-------------------------------------------------------------*
//G001COMP EXEC DFHEITALC,
//             PARM.TRN='',
//             PARM.PC='HOST(COBOL),SOURCE,XREF,NOMARGIN',
//             PARM.COB='LIB,APOST,MAP,NODYNAM',
//             PARM.LKED='XREF,LET,LIST,AMODE=31,RMODE=ANY'
//*
//TRN.SYSIN  DD DSN=&HLQ..GSTK.SOURCE(GSTK001),DISP=SHR
//PC.DBRMLIB DD DSN=&HLQ..GSTK.DBRMLIB(GSTK001),DISP=SHR
//COB.SYSLIB DD DSN=&HLQ..GSTK.COPYLIB,DISP=SHR
//           DD DSN=&CICSHLQ..SDFHCOB,DISP=SHR
//           DD DSN=&DB2HLQ..SDSNMACS,DISP=SHR
//LKED.SYSLMOD DD DSN=&HLQ..GSTK.LOADLIB(GSTK001),DISP=SHR
//LKED.SYSLIB  DD DSN=&CICSHLQ..SDFHLOAD,DISP=SHR
//             DD DSN=&DB2HLQ..SDSNLOAD,DISP=SHR
//             DD DSN=SYS1.COBLIB,DISP=SHR
//*
//G002COMP EXEC DFHEITALC,
//             PARM.TRN='',
//             PARM.PC='HOST(COBOL),SOURCE,XREF,NOMARGIN',
//             PARM.COB='LIB,APOST,MAP,NODYNAM',
//             PARM.LKED='XREF,LET,LIST,AMODE=31,RMODE=ANY'
//TRN.SYSIN  DD DSN=&HLQ..GSTK.SOURCE(GSTK002),DISP=SHR
//PC.DBRMLIB DD DSN=&HLQ..GSTK.DBRMLIB(GSTK002),DISP=SHR
//COB.SYSLIB DD DSN=&HLQ..GSTK.COPYLIB,DISP=SHR
//           DD DSN=&CICSHLQ..SDFHCOB,DISP=SHR
//           DD DSN=&DB2HLQ..SDSNMACS,DISP=SHR
//LKED.SYSLMOD DD DSN=&HLQ..GSTK.LOADLIB(GSTK002),DISP=SHR
//LKED.SYSLIB  DD DSN=&CICSHLQ..SDFHLOAD,DISP=SHR
//             DD DSN=&DB2HLQ..SDSNLOAD,DISP=SHR
//             DD DSN=SYS1.COBLIB,DISP=SHR
//*
//G003COMP EXEC DFHEITALC,PARM.TRN='',
//             PARM.PC='HOST(COBOL),SOURCE,XREF,NOMARGIN',
//             PARM.COB='LIB,APOST,MAP,NODYNAM',
//             PARM.LKED='XREF,LET,LIST,AMODE=31,RMODE=ANY'
//TRN.SYSIN  DD DSN=&HLQ..GSTK.SOURCE(GSTK003),DISP=SHR
//PC.DBRMLIB DD DSN=&HLQ..GSTK.DBRMLIB(GSTK003),DISP=SHR
//COB.SYSLIB DD DSN=&HLQ..GSTK.COPYLIB,DISP=SHR
//           DD DSN=&CICSHLQ..SDFHCOB,DISP=SHR
//           DD DSN=&DB2HLQ..SDSNMACS,DISP=SHR
//LKED.SYSLMOD DD DSN=&HLQ..GSTK.LOADLIB(GSTK003),DISP=SHR
//LKED.SYSLIB  DD DSN=&CICSHLQ..SDFHLOAD,DISP=SHR
//             DD DSN=&DB2HLQ..SDSNLOAD,DISP=SHR
//             DD DSN=SYS1.COBLIB,DISP=SHR
//*
//G004COMP EXEC DFHEITALC,PARM.TRN='',
//             PARM.PC='HOST(COBOL),SOURCE,XREF,NOMARGIN',
//             PARM.COB='LIB,APOST,MAP,NODYNAM',
//             PARM.LKED='XREF,LET,LIST,AMODE=31,RMODE=ANY'
//TRN.SYSIN  DD DSN=&HLQ..GSTK.SOURCE(GSTK004),DISP=SHR
//PC.DBRMLIB DD DSN=&HLQ..GSTK.DBRMLIB(GSTK004),DISP=SHR
//COB.SYSLIB DD DSN=&HLQ..GSTK.COPYLIB,DISP=SHR
//           DD DSN=&CICSHLQ..SDFHCOB,DISP=SHR
//           DD DSN=&DB2HLQ..SDSNMACS,DISP=SHR
//LKED.SYSLMOD DD DSN=&HLQ..GSTK.LOADLIB(GSTK004),DISP=SHR
//LKED.SYSLIB  DD DSN=&CICSHLQ..SDFHLOAD,DISP=SHR
//             DD DSN=&DB2HLQ..SDSNLOAD,DISP=SHR
//             DD DSN=SYS1.COBLIB,DISP=SHR
//*
//G005COMP EXEC DFHEITALC,PARM.TRN='',
//             PARM.PC='HOST(COBOL),SOURCE,XREF,NOMARGIN',
//             PARM.COB='LIB,APOST,MAP,NODYNAM',
//             PARM.LKED='XREF,LET,LIST,AMODE=31,RMODE=ANY'
//TRN.SYSIN  DD DSN=&HLQ..GSTK.SOURCE(GSTK005),DISP=SHR
//PC.DBRMLIB DD DSN=&HLQ..GSTK.DBRMLIB(GSTK005),DISP=SHR
//COB.SYSLIB DD DSN=&HLQ..GSTK.COPYLIB,DISP=SHR
//           DD DSN=&CICSHLQ..SDFHCOB,DISP=SHR
//           DD DSN=&DB2HLQ..SDSNMACS,DISP=SHR
//LKED.SYSLMOD DD DSN=&HLQ..GSTK.LOADLIB(GSTK005),DISP=SHR
//LKED.SYSLIB  DD DSN=&CICSHLQ..SDFHLOAD,DISP=SHR
//             DD DSN=&DB2HLQ..SDSNLOAD,DISP=SHR
//             DD DSN=SYS1.COBLIB,DISP=SHR
//*
//G006COMP EXEC DFHEITALC,PARM.TRN='',
//             PARM.PC='HOST(COBOL),SOURCE,XREF,NOMARGIN',
//             PARM.COB='LIB,APOST,MAP,NODYNAM',
//             PARM.LKED='XREF,LET,LIST,AMODE=31,RMODE=ANY'
//TRN.SYSIN  DD DSN=&HLQ..GSTK.SOURCE(GSTK006),DISP=SHR
//PC.DBRMLIB DD DSN=&HLQ..GSTK.DBRMLIB(GSTK006),DISP=SHR
//COB.SYSLIB DD DSN=&HLQ..GSTK.COPYLIB,DISP=SHR
//           DD DSN=&CICSHLQ..SDFHCOB,DISP=SHR
//           DD DSN=&DB2HLQ..SDSNMACS,DISP=SHR
//LKED.SYSLMOD DD DSN=&HLQ..GSTK.LOADLIB(GSTK006),DISP=SHR
//LKED.SYSLIB  DD DSN=&CICSHLQ..SDFHLOAD,DISP=SHR
//             DD DSN=&DB2HLQ..SDSNLOAD,DISP=SHR
//             DD DSN=SYS1.COBLIB,DISP=SHR
//*
//G007COMP EXEC DFHEITALC,PARM.TRN='',
//             PARM.PC='HOST(COBOL),SOURCE,XREF,NOMARGIN',
//             PARM.COB='LIB,APOST,MAP,NODYNAM',
//             PARM.LKED='XREF,LET,LIST,AMODE=31,RMODE=ANY'
//TRN.SYSIN  DD DSN=&HLQ..GSTK.SOURCE(GSTK007),DISP=SHR
//PC.DBRMLIB DD DSN=&HLQ..GSTK.DBRMLIB(GSTK007),DISP=SHR
//COB.SYSLIB DD DSN=&HLQ..GSTK.COPYLIB,DISP=SHR
//           DD DSN=&CICSHLQ..SDFHCOB,DISP=SHR
//           DD DSN=&DB2HLQ..SDSNMACS,DISP=SHR
//LKED.SYSLMOD DD DSN=&HLQ..GSTK.LOADLIB(GSTK007),DISP=SHR
//LKED.SYSLIB  DD DSN=&CICSHLQ..SDFHLOAD,DISP=SHR
//             DD DSN=&DB2HLQ..SDSNLOAD,DISP=SHR
//             DD DSN=SYS1.COBLIB,DISP=SHR
//*
//* FIN JOB GSTKCOMP
