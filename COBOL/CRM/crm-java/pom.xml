<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>crm</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>CRM — migration Java 8 : D05_VERIF_CRM, T10_MAJ_DTLIVR_BDCRM, D02_EXTCDE_CRMCSP1, D05_INTCDEFAC_CRM_V2</name>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
            </plugin>

            <!-- Deux JARs exécutables : D05 et T10 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <!-- JAR principal = D05 -->
                    <execution>
                        <id>default-jar</id>
                        <configuration>
                            <archive>
                                <manifest>
                                    <mainClass>com.example.crm.d05.main.D05Main</mainClass>
                                </manifest>
                            </archive>
                            <finalName>d05-verif-crm</finalName>
                        </configuration>
                    </execution>
                    <!-- JAR secondaire = T10 -->
                    <execution>
                        <id>t10-jar</id>
                        <phase>package</phase>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <archive>
                                <manifest>
                                    <mainClass>com.example.crm.t10.main.T10Main</mainClass>
                                </manifest>
                            </archive>
                            <finalName>t10-maj-dtlivr-bdcrm</finalName>
                        </configuration>
                    </execution>
                    <!-- JAR quaternaire = D05_INTCDEFAC -->
                    <execution>
                        <id>d05-intcdefac</id>
                        <phase>package</phase>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <finalName>d05-intcdefac-crm-v2</finalName>
                            <archive>
                                <manifest>
                                    <mainClass>com.example.crm.d05intcde.main.D05IntcdefacMain</mainClass>
                                </manifest>
                            </archive>
                        </configuration>
                    </execution>
                    <!-- JAR tertiaire = D02 -->
                    <execution>
                        <id>d02-extcde-crmcsp1</id>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>d02-extcde-crmcsp1</classifier>
                            <archive>
                                <manifest>
                                    <mainClass>com.example.crm.d02.main.D02Main</mainClass>
                                </manifest>
                            </archive>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
