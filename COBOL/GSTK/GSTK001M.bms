         TITLE 'GSTK001M - MAPSET CONSULTATION STOCK'
*======================================================================*
* MAPSET  : GSTK001M                                                   *
* MAP     : GSTK001                                                    *
* ECRAN   : CONSULTATION STOCK - LISTE AVEC FILTRES ET BARRE ASCII    *
* TAILLE  : 24 x 132  (3270 Model 5)                                  *
* TRANS   : G001                                                       *
*----------------------------------------------------------------------*
* COLONNES DONNEES (position attribut -> debut donnees) :              *
*   SEL(1->2) LN(3->4) AC(7->8) DS(18->19) CT(43->44) QT(53->54)          *
*   MN(59->60) MX(64->65) PU(70->71) VL(79->80) GR(90->91)               *
*   ST(111->112) EM(120->121)                                           *
*======================================================================*
GSTK001M DFHMSD TYPE=&SYSPARM,                                         X
               LANG=COBOL,                                             X
               MODE=INOUT,                                             X
               TIOAPFX=YES
*
GSTK001  DFHMDI SIZE=(24,132),                                         X
               LINE=1,                                                 X
               COLUMN=1
*
*----------------------------------------------------------------------*
* LIGNE 3 : TITRE + DATE/HEURE                                        *
*----------------------------------------------------------------------*
         DFHMDF POS=(3,2),                                             X
               LENGTH=30,                                              X
               ATTRB=(ASKIP,BRT),                                      X
               INITIAL='GSTK001 - CONSULTATION STOCK'
DATHR    DFHMDF POS=(3,111),                                           X
               LENGTH=19,                                              X
               ATTRB=(ASKIP,NORM)
*
*----------------------------------------------------------------------*
* LIGNE 4 : FILTRES DE RECHERCHE                                      *
*----------------------------------------------------------------------*
         DFHMDF POS=(4,1),                                             X
               LENGTH=11,                                              X
               ATTRB=(ASKIP,NORM),                                     X
               INITIAL='CODE ART ['
FILCO    DFHMDF POS=(4,13),                                            X
               LENGTH=10,                                              X
               ATTRB=(UNPROT,NORM)
         DFHMDF POS=(4,24),                                            X
               LENGTH=11,                                              X
               ATTRB=(ASKIP,NORM),                                     X
               INITIAL='] LIBELLE ['
