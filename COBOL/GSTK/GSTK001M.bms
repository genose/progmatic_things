               LENGTH=10,                                              X
               ATTRB=(ASKIP,BRT),                                      X
               INITIAL=' CATEG.'
         DFHMDF POS=(6,53),                                            X
               LENGTH=6,                                               X
               ATTRB=(ASKIP,BRT),                                      X
