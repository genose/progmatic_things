               LENGTH=20,                                              X
               ATTRB=(UNPROT,NORM)
         DFHMDF POS=(4,57),                                            X
               LENGTH=9,                                               X
               ATTRB=(ASKIP,NORM),                                     X
               INITIAL='] CATEG ['
FILCA    DFHMDF POS=(4,67),                                            X
               LENGTH=15,                                              X
               ATTRB=(UNPROT,NORM)
         DFHMDF POS=(4,83),                                            X
               LENGTH=10,                                              X
               ATTRB=(ASKIP,NORM),                                     X
               INITIAL='] STATUT ['
FILST    DFHMDF POS=(4,94),                                            X
               LENGTH=10,                                              X
               ATTRB=(UNPROT,NORM)
         DFHMDF POS=(4,105),                                           X
               LENGTH=1,                                               X
               ATTRB=(ASKIP,NORM),                                     X
               INITIAL=']'
