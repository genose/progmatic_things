NA06     DFHMDF POS=(12,28),LENGTH=6,ATTRB=(ASKIP,NORM)
QT06     DFHMDF POS=(12,38),LENGTH=12,ATTRB=(ASKIP,NORM)
VL06     DFHMDF POS=(12,56),LENGTH=15,ATTRB=(ASKIP,NORM)
AL06     DFHMDF POS=(12,74),LENGTH=5,ATTRB=(ASKIP,BRT)
PC06     DFHMDF POS=(12,84),LENGTH=6,ATTRB=(ASKIP,NORM)
*
CT07     DFHMDF POS=(13,2),LENGTH=15,ATTRB=(ASKIP,BRT)
NA07     DFHMDF POS=(13,28),LENGTH=6,ATTRB=(ASKIP,NORM)
QT07     DFHMDF POS=(13,38),LENGTH=12,ATTRB=(ASKIP,NORM)
VL07     DFHMDF POS=(13,56),LENGTH=15,ATTRB=(ASKIP,NORM)
AL07     DFHMDF POS=(13,74),LENGTH=5,ATTRB=(ASKIP,BRT)
PC07     DFHMDF POS=(13,84),LENGTH=6,ATTRB=(ASKIP,NORM)
*
CT08     DFHMDF POS=(14,2),LENGTH=15,ATTRB=(ASKIP,BRT)
NA08     DFHMDF POS=(14,28),LENGTH=6,ATTRB=(ASKIP,NORM)
QT08     DFHMDF POS=(14,38),LENGTH=12,ATTRB=(ASKIP,NORM)
VL08     DFHMDF POS=(14,56),LENGTH=15,ATTRB=(ASKIP,NORM)
AL08     DFHMDF POS=(14,74),LENGTH=5,ATTRB=(ASKIP,BRT)
PC08     DFHMDF POS=(14,84),LENGTH=6,ATTRB=(ASKIP,NORM)
*
CT09     DFHMDF POS=(15,2),LENGTH=15,ATTRB=(ASKIP,BRT)
NA09     DFHMDF POS=(15,28),LENGTH=6,ATTRB=(ASKIP,NORM)
QT09     DFHMDF POS=(15,38),LENGTH=12,ATTRB=(ASKIP,NORM)
VL09     DFHMDF POS=(15,56),LENGTH=15,ATTRB=(ASKIP,NORM)
AL09     DFHMDF POS=(15,74),LENGTH=5,ATTRB=(ASKIP,BRT)
PC09     DFHMDF POS=(15,84),LENGTH=6,ATTRB=(ASKIP,NORM)
