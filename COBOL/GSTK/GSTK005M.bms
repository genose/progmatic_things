         TITLE 'GSTK005M - MAPSET RAPPORTS STOCK'
*======================================================================*
* MAPSET  : GSTK005M                                                   *
* MAP     : GSTK005                                                    *
* ECRAN   : RAPPORTS STOCK PAR CATEGORIE                              *
* TAILLE  : 24 x 132  (3270 Model 5)                                  *
* TRANS   : G005                                                       *
*======================================================================*
GSTK005M DFHMSD TYPE=&SYSPARM,                                         X
               LANG=COBOL,                                             X
               MODE=INOUT,                                             X
               TIOAPFX=YES
*
GSTK005  DFHMDI SIZE=(24,132),                                         X
               LINE=1,                                                 X
               COLUMN=1
*
*----------------------------------------------------------------------*
* LIGNE 2 : TITRE                                                      *
*----------------------------------------------------------------------*
         DFHMDF POS=(2,2),LENGTH=25,ATTRB=(ASKIP,BRT),                X
               INITIAL='GSTK005 - RAPPORTS STOCK'
DATHR    DFHMDF POS=(2,111),LENGTH=19,ATTRB=(ASKIP,NORM)
*
*----------------------------------------------------------------------*
* LIGNE 4 : STATISTIQUES GLOBALES                                      *
*----------------------------------------------------------------------*
         DFHMDF POS=(4,2),LENGTH=18,ATTRB=(ASKIP,BRT),                X
               INITIAL='SYNTHESE GENERALE:'
         DFHMDF POS=(4,22),LENGTH=17,ATTRB=(ASKIP,NORM),              X
               INITIAL='ARTICLES ACTIFS : '
GAACT    DFHMDF POS=(4,39),LENGTH=6,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(4,46),LENGTH=17,ATTRB=(ASKIP,NORM),              X
               INITIAL=' VALEUR TOTALE : '
GAVLR    DFHMDF POS=(4,63),LENGTH=15,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(4,79),LENGTH=4,ATTRB=(ASKIP,NORM),INITIAL=' EUR'
         DFHMDF POS=(4,84),LENGTH=14,ATTRB=(ASKIP,NORM),              X
               INITIAL=' ALERTES MIN : '
GAALT    DFHMDF POS=(4,98),LENGTH=5,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(4,104),LENGTH=14,ATTRB=(ASKIP,NORM),             X
               INITIAL=' MVTS JOUR : '
GAMVT    DFHMDF POS=(4,117),LENGTH=6,ATTRB=(ASKIP,BRT)
*
*----------------------------------------------------------------------*
* LIGNE 6 : EN-TETES RAPPORT PAR CATEGORIE                           *
*----------------------------------------------------------------------*
         DFHMDF POS=(6,2),LENGTH=25,ATTRB=(ASKIP,BRT),                X
               INITIAL='CATEGORIE'
         DFHMDF POS=(6,28),LENGTH=10,ATTRB=(ASKIP,BRT),               X
               INITIAL=' NB.ART'
         DFHMDF POS=(6,38),LENGTH=18,ATTRB=(ASKIP,BRT),               X
               INITIAL=' QTE.TOTALE'
         DFHMDF POS=(6,56),LENGTH=18,ATTRB=(ASKIP,BRT),               X
               INITIAL=' VALEUR (EUR)'
         DFHMDF POS=(6,74),LENGTH=10,ATTRB=(ASKIP,BRT),               X
               INITIAL=' ALERTES'
         DFHMDF POS=(6,84),LENGTH=18,ATTRB=(ASKIP,BRT),               X
               INITIAL=' % DU STOCK TOTAL'
*
*----------------------------------------------------------------------*
* LIGNES 7-16 : 10 LIGNES PAR CATEGORIE                               *
*----------------------------------------------------------------------*
CT01     DFHMDF POS=(7,2),LENGTH=15,ATTRB=(ASKIP,BRT)
NA01     DFHMDF POS=(7,28),LENGTH=6,ATTRB=(ASKIP,NORM)
QT01     DFHMDF POS=(7,38),LENGTH=12,ATTRB=(ASKIP,NORM)
VL01     DFHMDF POS=(7,56),LENGTH=15,ATTRB=(ASKIP,NORM)
AL01     DFHMDF POS=(7,74),LENGTH=5,ATTRB=(ASKIP,BRT)
PC01     DFHMDF POS=(7,84),LENGTH=6,ATTRB=(ASKIP,NORM)
