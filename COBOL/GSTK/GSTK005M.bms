CT10     DFHMDF POS=(16,2),LENGTH=15,ATTRB=(ASKIP,BRT)
NA10     DFHMDF POS=(16,28),LENGTH=6,ATTRB=(ASKIP,NORM)
QT10     DFHMDF POS=(16,38),LENGTH=12,ATTRB=(ASKIP,NORM)
VL10     DFHMDF POS=(16,56),LENGTH=15,ATTRB=(ASKIP,NORM)
AL10     DFHMDF POS=(16,74),LENGTH=5,ATTRB=(ASKIP,BRT)
PC10     DFHMDF POS=(16,84),LENGTH=6,ATTRB=(ASKIP,NORM)
*
*----------------------------------------------------------------------*
* LIGNE 18 : TOTAL DU RAPPORT                                         *
*----------------------------------------------------------------------*
         DFHMDF POS=(18,2),LENGTH=10,ATTRB=(ASKIP,BRT),               X
               INITIAL='TOTAL    :'
TOTNA    DFHMDF POS=(18,28),LENGTH=6,ATTRB=(ASKIP,BRT)
TOTVL    DFHMDF POS=(18,56),LENGTH=15,ATTRB=(ASKIP,BRT)
TOTAL    DFHMDF POS=(18,74),LENGTH=5,ATTRB=(ASKIP,BRT)
*
*----------------------------------------------------------------------*
* LIGNE 20 : MESSAGE                                                   *
*----------------------------------------------------------------------*
MSGRTR   DFHMDF POS=(20,2),LENGTH=79,ATTRB=(ASKIP,BRT)
*
*----------------------------------------------------------------------*
* LIGNE 22 : PF KEYS                                                  *
*----------------------------------------------------------------------*
         DFHMDF POS=(22,2),LENGTH=50,ATTRB=(ASKIP,NORM),              X
               INITIAL='PF3=MENU  PF7=PAGE PREC.  PF8=PAGE SUIV.'
*
*----------------------------------------------------------------------*
* LIGNE 23 : SESSION + PAGINATION                                     *
*----------------------------------------------------------------------*
         DFHMDF POS=(23,2),LENGTH=10,ATTRB=(ASKIP,NORM),              X
               INITIAL='OPERATEUR:'
OPENAM   DFHMDF POS=(23,13),LENGTH=10,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(23,24),LENGTH=9,ATTRB=(ASKIP,NORM),              X
               INITIAL='TERMINAL:'
TERNAM   DFHMDF POS=(23,34),LENGTH=10,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(23,80),LENGTH=7,ATTRB=(ASKIP,NORM),              X
               INITIAL='PAGE :'
PAGCUR   DFHMDF POS=(23,88),LENGTH=4,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(23,93),LENGTH=1,ATTRB=(ASKIP,NORM),INITIAL='/'
PAGTOT   DFHMDF POS=(23,95),LENGTH=4,ATTRB=(ASKIP,NORM)
*
         DFHMSD TYPE=FINAL
         END
