//GSTKBMS  JOB (ACCT),'GSTK BMS ASSEMBLY',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,
//             USER=&SYSUID,PASSWORD=&TSO_PASS
//*
//*=============================================================*
//* JOB : GSTKBMS - ASSEMBLAGE DES MAPSETS BMS GSTK            *
//* Usage : soumettre depuis ISPF option 3.3                    *
//*                                                             *
//* ADAPTER :                                                   *
//*   HLQ     = votre HLQ (ex: HERC01)                         *
//*   CICSHLQ  = HLQ de CICS (ex: CICS.MACLIB)                 *
//*=============================================================*
//*
//         SET HLQ=HERC02
//         SET CICSHLQ=CICSTS
//*
//*-------------------------------------------------------------*
//* STEP 1 : ASSEMBLAGE MAP GSTK000M (MENU)
//*-------------------------------------------------------------*
//ASMG000  EXEC PGM=ASMA90,
//             PARM='OBJECT,NODECK,LIST,XREF(SHORT)'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//         DD DSN=&CICSHLQ..SDFHMAC,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&OBJ000,DISP=(NEW,PASS),
//             UNIT=SYSDA,SPACE=(TRK,(5,5))
//SYSIN    DD DSN=&HLQ..GSTK.BMS(GSTK000M),DISP=SHR
//*
//LKED000  EXEC PGM=IEWL,PARM='XREF,LET,LIST',
//             COND=(4,LT,ASMG000)
//SYSLIN   DD DSN=&&OBJ000,DISP=(OLD,DELETE)
//SYSLMOD  DD DSN=&HLQ..GSTK.LOADLIB(GSTK000M),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//*
//*-------------------------------------------------------------*
//* STEP 2 : GSTK001M (CONSULTATION STOCK)
//*-------------------------------------------------------------*
//ASMG001  EXEC PGM=ASMA90,
//             PARM='OBJECT,NODECK,LIST,XREF(SHORT)'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//         DD DSN=&CICSHLQ..SDFHMAC,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&OBJ001,DISP=(NEW,PASS),
//             UNIT=SYSDA,SPACE=(TRK,(5,5))
//SYSIN    DD DSN=&HLQ..GSTK.BMS(GSTK001M),DISP=SHR
//*
//LKED001  EXEC PGM=IEWL,PARM='XREF,LET,LIST',
//             COND=(4,LT,ASMG001)
//SYSLIN   DD DSN=&&OBJ001,DISP=(OLD,DELETE)
//SYSLMOD  DD DSN=&HLQ..GSTK.LOADLIB(GSTK001M),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//*
//*-------------------------------------------------------------*
//* STEP 3 : GSTK002M (ENTREE MARCHANDISE)
//*-------------------------------------------------------------*
//ASMG002  EXEC PGM=ASMA90,PARM='OBJECT,NODECK,LIST,XREF(SHORT)'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//         DD DSN=&CICSHLQ..SDFHMAC,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&OBJ002,DISP=(NEW,PASS),UNIT=SYSDA,SPACE=(TRK,(5,5))
//SYSIN    DD DSN=&HLQ..GSTK.BMS(GSTK002M),DISP=SHR
//LKED002  EXEC PGM=IEWL,PARM='XREF,LET,LIST',COND=(4,LT,ASMG002)
//SYSLIN   DD DSN=&&OBJ002,DISP=(OLD,DELETE)
//SYSLMOD  DD DSN=&HLQ..GSTK.LOADLIB(GSTK002M),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//*
//*-------------------------------------------------------------*
//* STEP 4 : GSTK003M (SORTIE MARCHANDISE)
//*-------------------------------------------------------------*
//ASMG003  EXEC PGM=ASMA90,PARM='OBJECT,NODECK,LIST,XREF(SHORT)'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//         DD DSN=&CICSHLQ..SDFHMAC,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&OBJ003,DISP=(NEW,PASS),UNIT=SYSDA,SPACE=(TRK,(5,5))
//SYSIN    DD DSN=&HLQ..GSTK.BMS(GSTK003M),DISP=SHR
//LKED003  EXEC PGM=IEWL,PARM='XREF,LET,LIST',COND=(4,LT,ASMG003)
//SYSLIN   DD DSN=&&OBJ003,DISP=(OLD,DELETE)
//SYSLMOD  DD DSN=&HLQ..GSTK.LOADLIB(GSTK003M),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//*
//*-------------------------------------------------------------*
//* STEP 5 : GSTK004M (CREATION/MODIF ARTICLE)
//*-------------------------------------------------------------*
//ASMG004  EXEC PGM=ASMA90,PARM='OBJECT,NODECK,LIST,XREF(SHORT)'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//         DD DSN=&CICSHLQ..SDFHMAC,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&OBJ004,DISP=(NEW,PASS),UNIT=SYSDA,SPACE=(TRK,(5,5))
//SYSIN    DD DSN=&HLQ..GSTK.BMS(GSTK004M),DISP=SHR
//LKED004  EXEC PGM=IEWL,PARM='XREF,LET,LIST',COND=(4,LT,ASMG004)
//SYSLIN   DD DSN=&&OBJ004,DISP=(OLD,DELETE)
//SYSLMOD  DD DSN=&HLQ..GSTK.LOADLIB(GSTK004M),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//*
//*-------------------------------------------------------------*
//* STEP 6 : GSTK005M (RAPPORTS)
//*-------------------------------------------------------------*
//ASMG005  EXEC PGM=ASMA90,PARM='OBJECT,NODECK,LIST,XREF(SHORT)'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//         DD DSN=&CICSHLQ..SDFHMAC,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&OBJ005,DISP=(NEW,PASS),UNIT=SYSDA,SPACE=(TRK,(5,5))
//SYSIN    DD DSN=&HLQ..GSTK.BMS(GSTK005M),DISP=SHR
//LKED005  EXEC PGM=IEWL,PARM='XREF,LET,LIST',COND=(4,LT,ASMG005)
//SYSLIN   DD DSN=&&OBJ005,DISP=(OLD,DELETE)
//SYSLMOD  DD DSN=&HLQ..GSTK.LOADLIB(GSTK005M),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//*
//*-------------------------------------------------------------*
//* STEP 7 : GSTK006M (ALERTES)
//*-------------------------------------------------------------*
//ASMG006  EXEC PGM=ASMA90,PARM='OBJECT,NODECK,LIST,XREF(SHORT)'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//         DD DSN=&CICSHLQ..SDFHMAC,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&OBJ006,DISP=(NEW,PASS),UNIT=SYSDA,SPACE=(TRK,(5,5))
//SYSIN    DD DSN=&HLQ..GSTK.BMS(GSTK006M),DISP=SHR
//LKED006  EXEC PGM=IEWL,PARM='XREF,LET,LIST',COND=(4,LT,ASMG006)
//SYSLIN   DD DSN=&&OBJ006,DISP=(OLD,DELETE)
//SYSLMOD  DD DSN=&HLQ..GSTK.LOADLIB(GSTK006M),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//*
//*-------------------------------------------------------------*
//* STEP 8 : GSTK007M (HISTORIQUE MOUVEMENTS)
//*-------------------------------------------------------------*
//ASMG007  EXEC PGM=ASMA90,PARM='OBJECT,NODECK,LIST,XREF(SHORT)'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//         DD DSN=&CICSHLQ..SDFHMAC,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&OBJ007,DISP=(NEW,PASS),UNIT=SYSDA,SPACE=(TRK,(5,5))
//SYSIN    DD DSN=&HLQ..GSTK.BMS(GSTK007M),DISP=SHR
//LKED007  EXEC PGM=IEWL,PARM='XREF,LET,LIST',COND=(4,LT,ASMG007)
//SYSLIN   DD DSN=&&OBJ007,DISP=(OLD,DELETE)
//SYSLMOD  DD DSN=&HLQ..GSTK.LOADLIB(GSTK007M),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//*
//* FIN JOB GSTKBMS
